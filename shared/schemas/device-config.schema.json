{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/shared/schemas/device-config.schema.json",
  "title": "Smart Matrix device configuration",
  "type": "object",
  "required": ["schemaVersion", "display", "clock"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "display": { "type": "object" },
    "clock": {
      "type": "object",
      "properties": {
        "layout": { "enum": ["minimal", "classic", "compact", "weather", "builder"] },
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "enabled", "x", "y", "scale"],
            "properties": {
              "id": { "enum": ["time", "date", "temperature", "wind", "status", "fault"] },
              "enabled": { "type": "boolean" },
              "x": { "type": "integer", "minimum": 0, "maximum": 127 },
              "y": { "type": "integer", "minimum": 0, "maximum": 63 },
              "scale": { "type": "integer", "minimum": 1, "maximum": 4 }
            }
          }
        }
      }
    },
    "layouts": { "type": "array", "maxItems": 128, "items": { "$ref": "layout.schema.json" } },
    "rules": { "type": "array", "maxItems": 128, "items": { "$ref": "rule.schema.json" } },
    "profiles": { "type": "array", "maxItems": 16, "items": { "type": "object" } },
    "activeLayoutId": { "type": "string", "maxLength": 64 },
    "activeProfileId": { "enum": ["normal", "night", "away", "demo", "fire"] },
    "idleRotation": { "type": "array", "maxItems": 32, "items": { "type": "object" } }
  }
}
